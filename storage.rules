rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // ═══════════════════════════════════════════════════════════════════
    // Hasta 2026-09-03 este archivo tenía `match /{allPaths=**} { allow read; }`
    // — sin condición. Eso hacía que TODA foto de jugador, carta generada
    // por IA y logo de liga fuera legible por cualquiera en internet, sin
    // sesión. Ahora la lectura pide sesión.
    //
    // Ojo: las download URLs de Firebase Storage (las que llevan
    // `?alt=media&token=...` y son las que se guardan en `photoUrl`)
    // siguen funcionando sin sesión por diseño — el token ES la
    // credencial. Esta regla protege el acceso por SDK y el listado del
    // bucket, que es por donde se podía enumerar.
    // ═══════════════════════════════════════════════════════════════════

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidImage() {
      return request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    /// Un clip de partido: 30 segundos de teléfono. 40 MB deja margen para
    /// 1080p sin habilitar la subida de un archivo cualquiera.
    function isValidClip() {
      return request.resource.size <= 40 * 1024 * 1024
        && request.resource.contentType.matches('video/.*');
    }

    /// Una nota de voz de evaluación: hasta 60 segundos AAC/M4A (~500 KB).
    /// 2 MB da margen holgado bloqueando archivos arbitrarios.
    function isValidAudio() {
      return request.resource.size <= 2 * 1024 * 1024
        && request.resource.contentType.matches('audio/.*');
    }

    // Piso general: leer requiere sesión salvo `evaluation-audios` (privados
    // por autor para preservar el anonimato hasta que acepte revelarse).
    match /{file} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    match /{folder}/{rest=**} {
      allow read: if isSignedIn() && folder != 'evaluation-audios';
      allow write: if false;
    }

    // Contenido deliberadamente público (compartir una carta por WhatsApp
    // a alguien que no tiene la app, por ejemplo).
    match /public/{allPaths=**} {
      allow read: if true;
      allow write: if false;
    }

    // Fotos de perfil: cada quien escribe y borra sólo la suya.
    match /profile-images/{userId}/{allPaths=**} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && request.auth.uid == userId && isValidImage();
      allow delete: if isSignedIn() && request.auth.uid == userId;
    }

    // Logos de liga (ruta vieja, por compatibilidad).
    match /league-logos/{userId}/{allPaths=**} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && request.auth.uid == userId && isValidImage();
      allow delete: if isSignedIn() && request.auth.uid == userId;
    }

    match /leagues/{groupId}/{userId}/{allPaths=**} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && request.auth.uid == userId && isValidImage();
      allow delete: if isSignedIn() && request.auth.uid == userId;
    }

    match /cups/{groupId}/{userId}/{allPaths=**} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && request.auth.uid == userId && isValidImage();
      allow delete: if isSignedIn() && request.auth.uid == userId;
    }

    // Pertenecer al grupo: `groups/{groupId}.members` es la fuente de verdad
    // (la misma que usan las Cloud Functions). Si el grupo no existe, `get`
    // falla y la escritura se deniega.
    function isGroupMember(groupId) {
      return isSignedIn()
        && request.auth.uid in firestore.get(
          /databases/(default)/documents/groups/$(groupId)
        ).data.members;
    }

    // Escudos de equipos (PNG o imagen personalizada subida por el creador).
    // Escribir exige ser miembro del grupo: antes cualquier usuario con sesión
    // podía subir hasta 5 MB a la carpeta de cualquier grupo. Borrar sólo pide
    // ser el dueño del archivo, para poder limpiar aunque ya haya salido.
    match /team-crests/{groupId}/{userId}/{allPaths=**} {
      allow read: if isSignedIn();
      allow write: if request.auth != null
        && request.auth.uid == userId
        && isGroupMember(groupId)
        && isValidImage();
      allow delete: if isSignedIn() && request.auth.uid == userId;
    }

    // Fotos personalizadas de canchas del grupo.
    match /venue-photos/{groupId}/{userId}/{allPaths=**} {
      allow read: if isSignedIn();
      allow write: if request.auth != null
        && request.auth.uid == userId
        && isGroupMember(groupId)
        && isValidImage();
      allow delete: if isSignedIn() && request.auth.uid == userId;
    }

    // Clips del partido: el gol de Nico al 23'. El uid va en la ruta para que
    // cada uno pueda borrar lo suyo y nada más.
    match /match-clips/{matchId}/{userId}/{allPaths=**} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && request.auth.uid == userId && isValidClip();
      allow delete: if isSignedIn() && request.auth.uid == userId;
    }

    // Notas de voz de evaluaciones: SOLO el autor puede leer/escribir/borrar
    // directo desde el SDK. El jugador evaluado sólo accede mediante la Cloud
    // Function `getEvaluationAudio` si `identityRevealed == true`.
    match /evaluation-audios/{matchId}/{userId}/{allPaths=**} {
      allow read: if isSignedIn() && request.auth.uid == userId;
      allow write: if isSignedIn() && request.auth.uid == userId && isValidAudio();
      allow delete: if isSignedIn() && request.auth.uid == userId;
    }
  }
}
