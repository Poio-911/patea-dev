rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // ═══════════════════════════════════════════════════════════════════
    // Hasta 2026-09-03 este archivo tenía `match /{allPaths=**} { allow read; }`
    // — sin condición. Eso hacía que TODA foto de jugador, carta generada
    // por IA y logo de liga fuera legible por cualquiera en internet, sin
    // sesión. Ahora la lectura pide sesión.
    //
    // Ojo: las download URLs de Firebase Storage (las que llevan
    // `?alt=media&token=...` y son las que se guardan en `photoUrl`)
    // siguen funcionando sin sesión por diseño — el token ES la
    // credencial. Esta regla protege el acceso por SDK y el listado del
    // bucket, que es por donde se podía enumerar.
    // ═══════════════════════════════════════════════════════════════════

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidImage() {
      return request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    /// Un clip de partido: 30 segundos de teléfono. 40 MB deja margen para
    /// 1080p sin habilitar la subida de un archivo cualquiera.
    function isValidClip() {
      return request.resource.size <= 40 * 1024 * 1024
        && request.resource.contentType.matches('video/.*');
    }

    // Piso general: leer requiere sesión, escribir requiere regla explícita.
    match /{allPaths=**} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // Contenido deliberadamente público (compartir una carta por WhatsApp
    // a alguien que no tiene la app, por ejemplo).
    match /public/{allPaths=**} {
      allow read: if true;
      allow write: if false;
    }

    // Fotos de perfil: cada quien escribe y borra sólo la suya.
    match /profile-images/{userId}/{allPaths=**} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && request.auth.uid == userId && isValidImage();
      allow delete: if isSignedIn() && request.auth.uid == userId;
    }

    // Logos de liga (ruta vieja, por compatibilidad).
    match /league-logos/{userId}/{allPaths=**} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && request.auth.uid == userId && isValidImage();
      allow delete: if isSignedIn() && request.auth.uid == userId;
    }

    match /leagues/{groupId}/{userId}/{allPaths=**} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && request.auth.uid == userId && isValidImage();
      allow delete: if isSignedIn() && request.auth.uid == userId;
    }

    match /cups/{groupId}/{userId}/{allPaths=**} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && request.auth.uid == userId && isValidImage();
      allow delete: if isSignedIn() && request.auth.uid == userId;
    }

    // Clips del partido: el gol de Nico al 23'. El uid va en la ruta para que
    // cada uno pueda borrar lo suyo y nada más.
    match /match-clips/{matchId}/{userId}/{allPaths=**} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && request.auth.uid == userId && isValidClip();
      allow delete: if isSignedIn() && request.auth.uid == userId;
    }
  }
}
