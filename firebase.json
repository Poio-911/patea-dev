{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "functions": {
    "source": "functions",
    "predeploy": [
      "npm --prefix functions run build"
    ],
    "runtime": "nodejs22"
  },
  "hosting": {
    "public": "hosting-gateway",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [{
      "source": "**",
      "run": { "serviceId": "patea-dev-1", "region": "us-central1", "pinTag": true }
    }],
    "headers": [{
      "source": "/release.json",
      "headers": [{ "key": "Cache-Control", "value": "no-store" }]
    }]
  }
}
