{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "functions": {
    "source": "functions",
    "predeploy": [
      "npm --prefix functions run build"
    ],
    "runtime": "nodejs22"
  },
  "hosting": {
    "public": "hosting-gateway",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "redirects": [{
      "source": "/",
      "destination": "https://patea-dev-1--mil-disculpis.us-central1.hosted.app/",
      "type": 302
    }, {
      "source": "/:path*",
      "destination": "https://patea-dev-1--mil-disculpis.us-central1.hosted.app/:path",
      "type": 302
    }],
    "headers": [{
      "source": "/release.json",
      "headers": [{ "key": "Cache-Control", "value": "no-store" }]
    }]
  }
}
