rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ═══════════════════════════════════════════════════════════════════
    // NOTA IMPORTANTE SOBRE CÓMO SE EVALÚAN ESTAS REGLAS
    //
    // Las reglas de Firestore son ADITIVAS: si CUALQUIER bloque concede
    // acceso, el acceso se concede. No se pueden "restringir" desde abajo.
    //
    // Por eso este archivo NO tiene una regla comodín final
    // (`match /{document=**} { allow read: if isAuthenticated(); }`).
    // Esa regla existía hasta 2026-09-03 y anulaba en silencio TODAS las
    // reglas de privacidad de más arriba: cualquier usuario autenticado
    // podía leer transacciones de compra ajenas, el caché de IA declarado
    // como `if false`, y los borradores de evaluación de otros.
    //
    // Firestore deniega por defecto lo que no matchea ninguna regla, así
    // que toda colección leída desde un cliente TIENE que estar declarada
    // acá abajo explícitamente. Si se agrega una colección nueva que se
    // lee desde la web o desde Flutter, agregar su regla o va a fallar.
    // Las Server Actions y las Cloud Functions usan el Admin SDK, que
    // ignora estas reglas por completo — no necesitan entrada acá.
    // ═══════════════════════════════════════════════════════════════════

    // ---------- Helpers ----------

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function matchData(matchId) {
      return get(/databases/$(database)/documents/matches/$(matchId)).data;
    }

    function isMatchOwner(matchId) {
      return isAuthenticated() && matchData(matchId).ownerUid == request.auth.uid;
    }

    function isMatchParticipant(matchId) {
      return isAuthenticated() && (
        isMatchOwner(matchId)
        || (
          matchData(matchId).playerUids != null
          && request.auth.uid in matchData(matchId).playerUids
        )
      );
    }

    // Sólo cambian las claves listadas y ninguna otra.
    function onlyChanges(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }

    // ---------- Usuarios ----------

    match /users/{userId} {
      // Lectura abierta a autenticados: la app muestra nombres y avatares
      // de otros usuarios en todas las pantallas.
      //
      // ⚠️ Las reglas de Firestore no saben denegar campos sueltos de un
      // documento. Todo lo que se guarde acá es legible por cualquier
      // usuario autenticado. Los datos sensibles (tokens FCM, ubicación
      // exacta, integraciones de salud) van en subcolecciones privadas,
      // nunca como campos de este documento.
      allow read: if isAuthenticated();
      allow create, update, delete: if false;

      // Tokens FCM del usuario — privados, sólo el dueño.
      match /fcmTokens/{tokenId} {
        allow read, write: if isOwner(userId);
      }

      // Notificaciones del usuario.
      match /notifications/{notificationId} {
        allow read: if isOwner(userId);
        // El cliente sólo marca como leída / borra las propias.
        allow update, delete: if isOwner(userId);
        allow create: if false;
      }

      // Espejo privado de las evaluaciones que ESTE usuario emitió.
      // Permite al evaluador consultar sus propias evaluaciones sin que
      // `evaluatorId` tenga que ser legible en el documento público.
      match /myEvaluations/{evaluationId} {
        allow read: if isOwner(userId);
        allow write: if false;
      }

      // Integraciones de salud (Google Fit): privadas del dueño.
      match /healthConnections/{connectionId} {
        allow read: if isOwner(userId);
        allow write: if false;
      }
    }

    // ---------- Jugadores ----------

    match /players/{playerId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if false;

      match /ovrHistory/{historyId} {
        allow read: if isAuthenticated();
        allow write: if false;
      }

      // Cualquier otra subcolección de jugador: lectura, escritura server-side.
      match /{subcollection}/{docId} {
        allow read: if isAuthenticated();
        allow write: if false;
      }
    }

    match /playerAchievements/{achievementId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    // ---------- Grupos, equipos y canchas ----------

    match /groups/{groupId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if false;

      match /{subcollection}/{docId} {
        allow read: if isAuthenticated();
        allow write: if false;
      }
    }

    match /teams/{teamId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if false;

      match /invitations/{invitationId} {
        allow read: if isAuthenticated();
        allow write: if false;
      }

      match /{subcollection}/{docId} {
        allow read: if isAuthenticated();
        allow write: if false;
      }
    }

    match /groupTeams/{groupTeamId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    match /venues/{venueId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    match /availablePlayers/{playerId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if false;
    }

    // ---------- Partidos ----------

    match /matches/{matchId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if false;

      // Chat en vivo: participantes y organizador.
      match /messages/{messageId} {
        allow read: if isMatchParticipant(matchId);
        allow create: if isMatchParticipant(matchId)
          && request.resource.data.senderId == request.auth.uid;
        allow update: if isMatchParticipant(matchId);
        allow delete: if false;
      }

      // Presencia: cada uno escribe sólo su propio heartbeat.
      //
      // Abierto a cualquiera autenticado, no sólo a los que juegan: el
      // contador de "quién está mirando" existe justamente para el que NO
      // está en la cancha. Con `isMatchParticipant` el espectador no podía
      // anotarse y el contador contaba sólo jugadores.
      //
      // El id del documento es el uid, así que nadie puede inflar el número:
      // cada persona ocupa una sola fila, y sólo la suya. De paso sale más
      // barato — `isMatchParticipant` hace un get() del partido en cada
      // evaluación de la regla, y esto no lee nada.
      match /presence/{viewerId} {
        allow read: if isAuthenticated();
        allow create, update, delete: if isAuthenticated()
          && request.auth.uid == viewerId;
      }

      // Clips del partido. El archivo vive en Storage; acá va la ficha:
      // minuto, quién lo subió y a qué jugador corresponde.
      //
      // Sólo suben los que están en el partido (el organizador incluido).
      // Es la línea más razonable: el que filma desde el costado suele ser
      // uno de ellos, y abrirlo a cualquiera autenticado convierte esto en
      // un buzón donde cualquiera puede tirar video en el partido ajeno.
      // Cada uno borra lo suyo; nadie edita lo de nadie.
      match /clips/{clipId} {
        allow read: if isAuthenticated();
        allow create: if isMatchParticipant(matchId)
          && request.resource.data.uploadedBy == request.auth.uid;
        allow update: if false;
        allow delete: if isAuthenticated()
          && resource.data.uploadedBy == request.auth.uid;
      }

      // Invitaciones del partido: organizador o invitado.
      match /invitations/{invitationId} {
        allow read: if isAuthenticated() && (
          isMatchOwner(matchId)
          || resource.data.playerId == request.auth.uid
        );
        allow write: if false;
      }

      // Asignaciones de evaluación, submissions procesadas, performance, etc.
      match /{subcollection}/{docId} {
        allow read: if isAuthenticated();
        allow write: if false;
      }
    }

    // ---------- Consultas collectionGroup ----------
    //
    // Una collectionGroup query NO se evalúa contra la regla por ruta
    // (`/matches/{id}/assignments/{aid}`), sino contra su propio patrón
    // `/{path=**}/assignments/{aid}`. Sin estas reglas la consulta falla con
    // PERMISSION_DENIED aunque la ruta concreta esté permitida.
    //
    // Antes funcionaban por el comodín global; al sacarlo hay que declararlas.
    // Estas tres son TODAS las collectionGroup del proyecto (web + Flutter):
    // assignments, invitations y selfEvaluations.

    // Bandeja de invitaciones y badge del header (matches/ y teams/).
    match /{path=**}/invitations/{invitationId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    // Bandeja de evaluaciones: `where evaluatorId == uid and status == pending`.
    match /{path=**}/assignments/{assignmentId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    match /{path=**}/selfEvaluations/{selfEvaluationId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    match /invitations/{invitationId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    match /dateProposals/{proposalId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    // ---------- Evaluaciones ----------

    // Contenido de la evaluación: nota, etiquetas, jugador evaluado.
    //
    // La lectura es abierta a autenticados a propósito: el historial de
    // partidos de un jugador (player-match-history.tsx, player-recent-activity.tsx)
    // consulta `where('playerId', '==', X)` para CUALQUIER jugador cuyo
    // perfil se abra, y eso es una función central del producto.
    //
    // El anonimato NO se sostiene con esta regla, se sostiene con la forma
    // del documento: `evaluatorId` NO vive acá. Vive en la subcolección
    // privada `private/` de abajo, denegada a todo cliente, y se copia al
    // documento público sólo cuando el evaluador acepta revelar su identidad.
    match /evaluations/{evaluationId} {
      allow read: if isAuthenticated();
      allow write: if false;

      // Identidad del evaluador — jamás legible desde un cliente.
      // Sólo el Admin SDK (Cloud Functions) accede acá.
      match /private/{docId} {
        allow read, write: if false;
      }
    }

    match /selfEvaluations/{selfEvaluationId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    // Borradores enviados desde la UI: sólo su autor los lee.
    // Las consultas del cliente deben incluir `where('evaluatorId','==',uid)`
    // o Firestore las rechaza por no poder garantizar el filtro.
    match /evaluationSubmissions/{submissionId} {
      allow read: if isAuthenticated() && resource.data.evaluatorId == request.auth.uid;
      allow create, update, delete: if false;
    }

    // ---------- Competiciones ----------

    match /leagues/{leagueId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.ownerUid == request.auth.uid;
      allow update, delete: if isAuthenticated() && resource.data.ownerUid == request.auth.uid;

      match /{subcollection}/{docId} {
        allow read: if isAuthenticated();
        allow write: if isAuthenticated()
          && get(/databases/$(database)/documents/leagues/$(leagueId)).data.ownerUid == request.auth.uid;
      }
    }

    match /cups/{cupId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.ownerUid == request.auth.uid;
      allow update, delete: if isAuthenticated() && resource.data.ownerUid == request.auth.uid;

      match /{subcollection}/{docId} {
        allow read: if isAuthenticated();
        allow write: if isAuthenticated()
          && get(/databases/$(database)/documents/cups/$(cupId)).data.ownerUid == request.auth.uid;
      }
    }

    match /competitionTemplates/{templateId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    match /competitionApplications/{applicationId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    match /applications/{applicationId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    match /teamAvailabilityPosts/{postId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    match /referees/{refereeId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    // ---------- Social ----------

    match /socialActivities/{activityId} {
      allow read: if isAuthenticated();
      allow write: if false;

      match /comments/{commentId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated()
          && request.resource.data.userId == request.auth.uid;
        // El update existe sólo para los likes: cualquier autenticado puede
        // dar like, pero no puede reescribir el texto ni robar la autoría
        // de un comentario ajeno.
        allow update: if isAuthenticated() && onlyChanges(['likes', 'likedBy']);
        allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
      }
    }

    match /feedActivities/{activityId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    match /follows/{followId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    match /following/{followingId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    // ---------- Monetización ----------

    match /creditPackages/{packageId} {
      // Públicos: se muestran en la tienda.
      allow read: if true;
      allow write: if false;
    }

    match /creditTransactions/{transactionId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow write: if false;
    }

    // ---------- Sólo servidor ----------
    // Declaradas explícitamente para dejar la intención por escrito.
    // El Admin SDK las usa igual: ignora estas reglas.

    match /ai_cache/{cacheId} {
      allow read, write: if false;
    }

    match /systemLogs/{logId} {
      allow read, write: if false;
    }

    match /healthConnections/{connectionId} {
      allow read, write: if false;
    }
  }
}
