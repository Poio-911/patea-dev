rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ═══════════════════════════════════════════════════════════════════
    // NOTA IMPORTANTE SOBRE CÓMO SE EVALÚAN ESTAS REGLAS
    //
    // Las reglas de Firestore son ADITIVAS: si CUALQUIER bloque concede
    // acceso, el acceso se concede. No se pueden "restringir" desde abajo.
    //
    // Por eso este archivo NO tiene una regla comodín final
    // (`match /{document=**} { allow read: if isAuthenticated(); }`).
    // Esa regla existía hasta 2026-09-03 y anulaba en silencio TODAS las
    // reglas de privacidad de más arriba: cualquier usuario autenticado
    // podía leer transacciones de compra ajenas, el caché de IA declarado
    // como `if false`, y los borradores de evaluación de otros.
    //
    // Firestore deniega por defecto lo que no matchea ninguna regla, así
    // que toda colección leída desde un cliente TIENE que estar declarada
    // acá abajo explícitamente. Si se agrega una colección nueva que se
    // lee desde la web o desde Flutter, agregar su regla o va a fallar.
    // Las Server Actions y las Cloud Functions usan el Admin SDK, que
    // ignora estas reglas por completo — no necesitan entrada acá.
    // ═══════════════════════════════════════════════════════════════════

    // ---------- Helpers ----------

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function matchData(matchId) {
      return get(/databases/$(database)/documents/matches/$(matchId)).data;
    }

    function isMatchOwner(matchId) {
      return isAuthenticated() && matchData(matchId).ownerUid == request.auth.uid;
    }

    // Participa quien organiza, quien juega (`playerUids` trae a los jugadores
    // de LOS DOS equipos en un partido entre equipos) o es capitán. Los
    // capitanes de un partido entre grupos distintos no siempre juegan —el
    // creador del equipo puede ser el DT— y tienen que poder subir clips y
    // escribir en el chat de su partido igual que el rival.
    //
    // `.get(campo, valor)` y no `.campo`: un partido sin `captains` (todos los
    // anteriores a los desafíos) no debe romper la regla.
    function isMatchParticipant(matchId) {
      return isAuthenticated() && (
        isMatchOwner(matchId)
        || request.auth.uid in matchData(matchId).get('playerUids', [])
        || request.auth.uid in matchData(matchId).get('captains', [])
      );
    }

    // Organizador o capitán: quienes gestionan el partido.
    function isMatchManager(matchId) {
      return isAuthenticated() && (
        isMatchOwner(matchId)
        || request.auth.uid in matchData(matchId).get('captains', [])
      );
    }

    // ¿Es de alguno de los grupos que participan en el partido?
    // `users/{uid}.groups` lo mantienen createGroup / joinGroupByInviteCode /
    // setActiveGroup; `activeGroupId` cubre a quienes todavía no tienen la lista.
    function isGroupLinked(matchId) {
      return isAuthenticated()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && (
          matchData(matchId).get('groupId', '') in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('groups', [])
          || matchData(matchId).get('groupId', '') == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('activeGroupId', '-')
          || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('groups', []).hasAny(matchData(matchId).get('participantGroupIds', []))
        );
    }

    // Vinculado: participa, o es de un grupo que participa.
    function isMatchLinked(matchId) {
      return isMatchParticipant(matchId) || isGroupLinked(matchId);
    }

    // Lo que ve cualquiera: un partido público. Lo privado, sólo vinculados.
    function canSeeMatchContent(matchId) {
      return isAuthenticated() && (
        matchData(matchId).get('isPublic', false) == true
        || isMatchLinked(matchId)
      );
    }

    // Sólo cambian las claves listadas y ninguna otra.
    function onlyChanges(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }

    // ---------- Usuarios ----------

    match /users/{userId} {
      // Lectura abierta a autenticados: la app muestra nombres y avatares
      // de otros usuarios en todas las pantallas.
      //
      // ⚠️ Las reglas de Firestore no saben denegar campos sueltos de un
      // documento. Todo lo que se guarde acá es legible por cualquier
      // usuario autenticado. Los datos sensibles (tokens FCM, ubicación
      // exacta, integraciones de salud) van en subcolecciones privadas,
      // nunca como campos de este documento.
      allow read: if isAuthenticated();
      allow create, update, delete: if false;

      // Tokens FCM del usuario — privados, sólo el dueño.
      match /fcmTokens/{tokenId} {
        allow read, write: if isOwner(userId);
      }

      // Notificaciones del usuario.
      match /notifications/{notificationId} {
        allow read: if isOwner(userId);
        // El cliente sólo marca como leída / borra las propias.
        allow update, delete: if isOwner(userId);
        allow create: if false;
      }

      // Espejo privado de las evaluaciones que ESTE usuario emitió.
      // Permite al evaluador consultar sus propias evaluaciones sin que
      // `evaluatorId` tenga que ser legible en el documento público.
      match /myEvaluations/{evaluationId} {
        allow read: if isOwner(userId);
        allow write: if false;
      }

      match /evaluationSubmissionErrors/{submissionId} {
        allow read: if isOwner(userId);
        allow write: if false;
      }

      // Integraciones de salud (Google Fit): privadas del dueño.
      match /healthConnections/{connectionId} {
        allow read: if isOwner(userId);
        allow write: if false;
      }
    }

    // Contacto para recuperar perfiles sin cuenta: únicamente Cloud Functions.
    match /manualPlayerContacts/{playerId} {
      allow read, write: if false;
    }

    // Private saved rivals, result ledger and transactional challenge guards.
    match /teamRivals/{id} { allow read, write: if false; }
    match /teamRivalResults/{id} { allow read, write: if false; }
    match /teamRivalPairs/{id} { allow read, write: if false; }
    match /teamRivalTeams/{id} { allow read, write: if false; }
    match /teamChallengeLimits/{id} { allow read, write: if false; }

    // ---------- Jugadores ----------

    match /players/{playerId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if false;

      match /ovrHistory/{historyId} {
        allow read: if isAuthenticated();
        allow write: if false;
      }

      // Cualquier otra subcolección de jugador: lectura, escritura server-side.
      match /{subcollection}/{docId} {
        allow read: if isAuthenticated();
        allow write: if false;
      }
    }

    match /playerAchievements/{achievementId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    // ---------- Grupos, equipos y canchas ----------

    match /groups/{groupId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if false;

      match /{subcollection}/{docId} {
        allow read: if isAuthenticated();
        allow write: if false;
      }
    }

    match /teams/{teamId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if false;

      match /invitations/{invitationId} {
        allow read: if isAuthenticated();
        allow write: if false;
      }

      match /{subcollection}/{docId} {
        allow read: if isAuthenticated();
        allow write: if false;
      }
    }

    match /groupTeams/{groupTeamId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    match /venues/{venueId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    match /availablePlayers/{playerId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if false;
    }

    // ---------- Partidos ----------

    match /matches/{matchId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if false;

      // Chat en vivo: participantes y organizador.
      match /messages/{messageId} {
        allow read: if isMatchParticipant(matchId);
        allow create: if isMatchParticipant(matchId)
          && request.resource.data.senderId == request.auth.uid;
        // Antes cualquier participante podía reescribir cualquier mensaje, hasta
        // el `senderId`. Ahora, los participantes sólo tocan lo que es de todos
        // (reacciones y acuses de lectura) y cada uno edita sólo lo suyo.
        allow update: if isMatchParticipant(matchId) && (
          onlyChanges(['reactions', 'deliveredTo', 'readBy', 'status'])
          || (
            resource.data.senderId == request.auth.uid
            && onlyChanges(['text', 'editedAt'])
          )
        );
        allow delete: if false;
      }

      // Presencia: cada uno escribe sólo su propio heartbeat.
      //
      // Abierto a cualquiera autenticado, no sólo a los que juegan: el
      // contador de "quién está mirando" existe justamente para el que NO
      // está en la cancha. Con `isMatchParticipant` el espectador no podía
      // anotarse y el contador contaba sólo jugadores.
      //
      // El id del documento es el uid, así que nadie puede inflar el número:
      // cada persona ocupa una sola fila, y sólo la suya. De paso sale más
      // barato — `isMatchParticipant` hace un get() del partido en cada
      // evaluación de la regla, y esto no lee nada.
      //
      // Pero sí acotado a quien puede VER el partido: uno público lo mira
      // cualquiera; uno privado, sólo vinculados.
      match /presence/{viewerId} {
        allow read: if canSeeMatchContent(matchId);
        allow create, update, delete: if canSeeMatchContent(matchId)
          && request.auth.uid == viewerId;
      }

      // Clips del partido. El archivo vive en Storage; acá va la ficha:
      // minuto, quién lo subió y a qué jugador corresponde.
      //
      // Sólo suben los que están en el partido (el organizador y los
      // capitanes incluidos). En un partido entre equipos suben los jugadores
      // de AMBOS equipos, no sólo los del que lo organiza.
      // Es la línea más razonable: el que filma desde el costado suele ser
      // uno de ellos, y abrirlo a cualquiera autenticado convierte esto en
      // un buzón donde cualquiera puede tirar video en el partido ajeno.
      // Cada uno borra lo suyo; nadie edita lo de nadie.
      //
      // Suben todos los VINCULADOS: organizador, capitanes, jugadores de
      // cualquiera de los equipos y miembros de los grupos que participan (el
      // que filma desde el costado). No un tercero. Sólo con el partido en vivo
      // o terminado. El id es `{uid}_{0-9}`: así hay a lo sumo 10 por persona
      // sin necesidad de contar. Los gestores pueden borrar cualquiera.
      match /clips/{clipId} {
        allow read: if canSeeMatchContent(matchId);
        allow create: if isMatchLinked(matchId)
          && request.resource.data.uploadedBy == request.auth.uid
          && matchData(matchId).get('status', '') in ['active', 'completed', 'evaluated']
          && clipId.matches('^' + request.auth.uid + '_[0-9]$');
        allow update: if false;
        allow delete: if isAuthenticated()
          && (resource.data.uploadedBy == request.auth.uid || isMatchManager(matchId));
      }

      // Autoevaluaciones: sólo quienes participan del partido (el resumen del
      // jugador las junta). Antes las leía cualquier usuario con sesión.
      match /selfEvaluations/{selfEvaluationId} {
        allow read: if isMatchParticipant(matchId);
        allow write: if false;
      }

      // Solicitudes para entrar: las ve el organizador (y quien pidió), nadie más.
      // Traen el perfil de cada solicitante.
      match /joinRequests/{requesterId} {
        allow read: if isMatchManager(matchId) || request.auth.uid == requesterId;
        allow write: if false;
      }

      // Invitaciones del partido: organizador o invitado.
      match /invitations/{invitationId} {
        allow read: if isAuthenticated() && (
          isMatchOwner(matchId)
          || resource.data.playerId == request.auth.uid
        );
        allow write: if false;
      }

      // Asignaciones de evaluación, submissions procesadas, performance, etc.
      match /assignments/{assignmentId} {
        // Los dos capitanes de un partido entre grupos cierran la evaluación,
        // así que los dos ven el avance.
        allow read: if isAuthenticated() && (
          resource.data.evaluatorId == request.auth.uid
          || isMatchOwner(matchId)
          || (
            matchData(matchId).get('type', '') == 'intergroup_friendly'
            && isMatchManager(matchId)
          )
        );
        allow write: if false;
      }

      match /processedSubmissions/{submissionId} {
        allow read: if isAuthenticated() && resource.data.evaluatorId == request.auth.uid;
        allow write: if false;
      }

      match /{subcollection}/{docId} {
        // Reglas aditivas: no volver a abrir las rutas privadas de arriba.
        allow read: if isAuthenticated()
          && !(subcollection in ['messages', 'invitations', 'assignments', 'processedSubmissions', 'joinRequests', 'clips', 'presence', 'selfEvaluations']);
        allow write: if false;
      }
    }

    // ---------- Consultas collectionGroup ----------
    //
    // Una collectionGroup query NO se evalúa contra la regla por ruta
    // (`/matches/{id}/assignments/{aid}`), sino contra su propio patrón
    // `/{path=**}/assignments/{aid}`. Sin estas reglas la consulta falla con
    // PERMISSION_DENIED aunque la ruta concreta esté permitida.
    //
    // Antes funcionaban por el comodín global; al sacarlo hay que declararlas.
    // Estas tres son TODAS las collectionGroup del proyecto (web + Flutter):
    // assignments, invitations y selfEvaluations.

    // Bandeja de invitaciones y badge del header (matches/ y teams/).
    match /{path=**}/invitations/{invitationId} {
      allow read: if isAuthenticated() && resource.data.playerId == request.auth.uid;
      allow write: if false;
    }

    // Bandeja de evaluaciones: `where evaluatorId == uid and status == pending`.
    match /{path=**}/assignments/{assignmentId} {
      allow read: if isAuthenticated() && resource.data.evaluatorId == request.auth.uid;
      allow write: if false;
    }

    // Las autoevaluaciones (goles, asistencias, cómo se sintió) las lee su autor
    // en una consulta de grupo; el servidor (Admin SDK) no pasa por las reglas.
    match /{path=**}/selfEvaluations/{selfEvaluationId} {
      allow read: if isAuthenticated() && resource.data.get('playerId', '') == request.auth.uid;
      allow write: if false;
    }

    match /invitations/{invitationId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    match /dateProposals/{proposalId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    // ---------- Evaluaciones ----------

    // Contenido de la evaluación: nota, etiquetas, jugador evaluado.
    //
    // La lectura es abierta a autenticados a propósito: el historial de
    // partidos de un jugador (player-match-history.tsx, player-recent-activity.tsx)
    // consulta `where('playerId', '==', X)` para CUALQUIER jugador cuyo
    // perfil se abra, y eso es una función central del producto.
    //
    // El anonimato NO se sostiene con esta regla, se sostiene con la forma
    // del documento: `evaluatorId` NO vive acá. Vive en la subcolección
    // privada `private/` de abajo, denegada a todo cliente, y se copia al
    // documento público sólo cuando el evaluador acepta revelar su identidad.
    match /evaluations/{evaluationId} {
      // El perfil obtiene la versión enmascarada mediante el servidor.
      // Restringir sólo campos es imposible en Firestore: el documento crudo
      // incluye la identidad del evaluador, también en registros antiguos.
      allow read: if isAuthenticated() && (
        resource.data.evaluatorId == request.auth.uid
        || resource.data.get('identityRevealed', false) == true
      );
      allow write: if false;

      // Identidad del evaluador — jamás legible desde un cliente.
      // Sólo el Admin SDK (Cloud Functions) accede acá.
      match /private/{docId} {
        allow read, write: if false;
      }
    }

    match /selfEvaluations/{selfEvaluationId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    // Borradores enviados desde la UI: sólo su autor los lee.
    // Las consultas del cliente deben incluir `where('evaluatorId','==',uid)`
    // o Firestore las rechaza por no poder garantizar el filtro.
    match /evaluationSubmissions/{submissionId} {
      allow read: if isAuthenticated() && resource.data.evaluatorId == request.auth.uid;
      allow create, update, delete: if false;
    }

    // ---------- Competiciones ----------

    match /leagues/{leagueId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.ownerUid == request.auth.uid;
      allow update, delete: if isAuthenticated() && resource.data.ownerUid == request.auth.uid;

      match /{subcollection}/{docId} {
        allow read: if isAuthenticated() && (subcollection != 'applications'
          || resource.data.get('submittedBy', '') == request.auth.uid
          || get(/databases/$(database)/documents/leagues/$(leagueId)).data.ownerUid == request.auth.uid);
        allow write: if isAuthenticated()
          && get(/databases/$(database)/documents/leagues/$(leagueId)).data.ownerUid == request.auth.uid;
      }
    }

    match /cups/{cupId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.ownerUid == request.auth.uid;
      allow update, delete: if isAuthenticated() && resource.data.ownerUid == request.auth.uid;

      match /{subcollection}/{docId} {
        allow read: if isAuthenticated() && (subcollection != 'applications'
          || resource.data.get('submittedBy', '') == request.auth.uid
          || get(/databases/$(database)/documents/cups/$(cupId)).data.ownerUid == request.auth.uid);
        allow write: if isAuthenticated()
          && get(/databases/$(database)/documents/cups/$(cupId)).data.ownerUid == request.auth.uid;
      }
    }

    match /competitionTemplates/{templateId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    match /competitionApplications/{applicationId} {
      allow read: if isAuthenticated() && (
        resource.data.get('submittedBy', '') == request.auth.uid
        || (resource.data.competitionType == 'league'
          && get(/databases/$(database)/documents/leagues/$(resource.data.competitionId)).data.ownerUid == request.auth.uid)
        || (resource.data.competitionType == 'cup'
          && get(/databases/$(database)/documents/cups/$(resource.data.competitionId)).data.ownerUid == request.auth.uid)
      );
      allow write: if false;
    }

    match /applications/{applicationId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    match /teamAvailabilityPosts/{postId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    match /referees/{refereeId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    // ---------- Social ----------

    match /socialActivities/{activityId} {
      allow read: if isAuthenticated();
      allow write: if false;

      match /comments/{commentId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated()
          && request.resource.data.userId == request.auth.uid;
        // El update existe sólo para los likes: cualquier autenticado puede
        // dar like, pero no puede reescribir el texto ni robar la autoría
        // de un comentario ajeno.
        allow update: if isAuthenticated() && onlyChanges(['likes', 'likedBy']);
        allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
      }
    }

    match /feedActivities/{activityId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    match /follows/{followId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    match /following/{followingId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    // ---------- Monetización ----------

    match /creditPackages/{packageId} {
      // Públicos: se muestran en la tienda.
      allow read: if true;
      allow write: if false;
    }

    match /creditTransactions/{transactionId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow write: if false;
    }

    // ---------- Sólo servidor ----------
    // Declaradas explícitamente para dejar la intención por escrito.
    // El Admin SDK las usa igual: ignora estas reglas.

    match /ai_cache/{cacheId} {
      allow read, write: if false;
    }

    match /systemLogs/{logId} {
      allow read, write: if false;
    }

    match /healthConnections/{connectionId} {
      allow read, write: if false;
    }
  }
}
