
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function matchData(matchId) {
      return get(/databases/$(database)/documents/matches/$(matchId)).data;
    }

    function isMatchOwner(matchId) {
      return isAuthenticated() && matchData(matchId).ownerUid == request.auth.uid;
    }

    function isMatchParticipant(matchId) {
      return isAuthenticated() && (
        isMatchOwner(matchId)
        || (
          matchData(matchId).playerUids != null
          && request.auth.uid in matchData(matchId).playerUids
        )
      );
    }

    // --- REGLAS PRINCIPALES ---

    // Colección de Usuarios
    match /users/{userId} {
      // ✅ CORRECCIÓN: Cualquier usuario autenticado puede leer perfiles.
      // Esto es necesario para mostrar nombres, avatares, etc. en toda la app.
      allow read: if isAuthenticated();
      // Escrituras sensibles migradas a Server Actions.
      allow create, update, delete: if false;

      // Subcolección de tokens FCM por usuario
      match /fcmTokens/{tokenId} {
        allow read: if isOwner(userId);
        allow write: if isOwner(userId);
      }

      // Subcolección de notificaciones por usuario
      match /notifications/{notificationId} {
        // Solo el dueño puede leer sus notificaciones
        allow read: if isOwner(userId);
        // El cliente solo puede marcar/borrar sus propias notificaciones.
        allow update, delete: if isOwner(userId);
        allow create: if false;
      }
    }
    
    // Colección de Jugadores
    match /players/{playerId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if false;
    }

    // Subcolección de historial de OVR (solo escritura desde el servidor)
    match /players/{playerId}/ovrHistory/{historyId} {
      allow read: if isAuthenticated();
      allow write: if false; 
    }

    // Colección de Grupos
    match /groups/{groupId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if false;
    }

    // Colección de Canchas (Venues)
    match /venues/{venueId} {
      // Cualquier usuario autenticado puede leer canchas
      allow read: if isAuthenticated();
      // La creación/edición/eliminación se maneja en Server Actions con permisos de grupo
      allow write: if false;
    }

    // Colección de Jugadores Disponibles (para fichajes)
    match /availablePlayers/{playerId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if false;
    }
    
    // Colección de Equipos Persistentes
    match /teams/{teamId} {
        allow read: if isAuthenticated();
      allow create, update, delete: if false;

        // Subcolección de invitaciones
        match /invitations/{invitationId} {
            allow read: if isAuthenticated();
        allow write: if false;
        }
    }

    // Colección de Partidos
    match /matches/{matchId} {
      allow read: if isAuthenticated();
      allow create: if false; 
      allow update, delete: if false;

      // Chat en vivo del partido: lectura/escritura para participantes y organizador.
      match /messages/{messageId} {
        allow read: if isMatchParticipant(matchId);
        allow create: if isMatchParticipant(matchId)
          && request.resource.data.senderId == request.auth.uid;
        allow update: if isMatchParticipant(matchId);
        allow delete: if false;
      }

      // Presencia en visualización del partido: cada usuario escribe sólo su propio heartbeat.
      match /presence/{viewerId} {
        allow read: if isMatchParticipant(matchId);
        allow create, update: if isMatchParticipant(matchId) && request.auth.uid == viewerId;
        allow delete: if isMatchParticipant(matchId) && request.auth.uid == viewerId;
      }

      // Invitaciones del partido: lectura para organizador y jugador invitado; mutaciones server-side.
      match /invitations/{invitationId} {
        allow read: if isAuthenticated() && (
          isMatchOwner(matchId)
          || resource.data.playerId == request.auth.uid
        );
        allow write: if false;
      }

      // Asignaciones y artefactos de evaluación: lectura autenticada, escritura server-side.
      match /assignments/{assignmentId} {
        allow read: if isAuthenticated();
        allow write: if false;
      }

      match /{subcollection}/{docId} {
        allow read: if isAuthenticated();
        allow write: if false;
      }
    }

    // Colección de Evaluaciones Temporales (las que envía el usuario desde la UI)
    match /evaluationSubmissions/{submissionId} {
      allow read: if isOwner(resource.data.evaluatorId);
      allow create, update, delete: if false; 
    }

    // --- MONETIZACIÓN ---

    // Paquetes de créditos (solo lectura para usuarios)
    match /creditPackages/{packageId} {
      allow read: if true;  // Públicos para mostrar en la tienda
      allow write: if false; // Solo admin/server puede crear/modificar
    }

    // Transacciones de compra (privadas, solo server-side)
    match /creditTransactions/{transactionId} {
      // Solo el usuario dueño puede leer su propia transacción
      allow read: if isAuthenticated() &&
                     request.auth.uid == resource.data.userId;
      // Solo server-side puede crear/actualizar
      allow write: if false;
    }

    // Colección de Caché de IA
    match /ai_cache/{cacheId} {
      // Solo accesible desde Server Actions (Cloud Functions)
      // Los clientes no deben leer ni escribir directamente
      allow read, write: if false;
    }

    // Social Activities - Public read for authenticated users
    match /socialActivities/{activityId} {
      allow read: if isAuthenticated();
      // Writes handled by server actions
      allow write: if false;

      // Comments subcollection
      match /comments/{commentId} {
        allow read: if isAuthenticated();
        // Create: any authenticated user can comment
        allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
        // Update: only comment owner can update (for likes)
        allow update: if isAuthenticated();
        // Delete: only comment owner can delete
        allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
      }
    }

    // --- PRIVACY & EVALUATIONS ---

    // Colección de Evaluaciones
    match /evaluations/{evaluationId} {
      // ✅ REGLA DE PRIVACIDAD: Solo pueden leer la evaluación:
      // 1. El evaluador.
      // 2. El jugador evaluado (sujeto).
      // 3. Cualquier usuario SI la identidad ya fue revelada explícitamente.
      allow read: if isAuthenticated() && (
        request.auth.uid == resource.data.evaluatorId ||
        request.auth.uid == resource.data.playerId ||
        (resource.data.identityRevealed == true)
      );
      // Las evaluaciones las crea el servidor (Admin SDK) o el sistema de transacciones.
      allow write: if false;
    }

    // --- LIGAS Y COPAS (ORGANIZADOR) ---
    match /leagues/{leagueId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.ownerUid == request.auth.uid;
      allow update, delete: if isAuthenticated() && resource.data.ownerUid == request.auth.uid;
      
      // Subcolecciones (fixtures, equipos fantasma, etc)
      match /{subcollection}/{docId} {
        allow read: if isAuthenticated();
        allow write: if isAuthenticated() && get(/databases/$(database)/documents/leagues/$(leagueId)).data.ownerUid == request.auth.uid;
      }
    }

    match /cups/{cupId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.ownerUid == request.auth.uid;
      allow update, delete: if isAuthenticated() && resource.data.ownerUid == request.auth.uid;

      // Subcolecciones (teams, bracket docs, etc)
      match /{subcollection}/{docId} {
        allow read: if isAuthenticated();
        allow write: if isAuthenticated() && get(/databases/$(database)/documents/cups/$(cupId)).data.ownerUid == request.auth.uid;
      }
    }

    // Regla de comodín final: solo lectura para autenticados.
    // Escriben solo las colecciones con reglas explícitas.
    match /{document=**} {
      allow read: if isAuthenticated();
      allow write: if false;
    }
  }
}
