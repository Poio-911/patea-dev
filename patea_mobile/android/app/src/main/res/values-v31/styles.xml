<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Desde Android 12 el sistema dibuja el splash por su cuenta y no mira
         `windowBackground`: usa estos tres atributos. Sin ellos aparecía el
         ícono de la app (que era el de Flutter) sobre fondo blanco. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowSplashScreenBackground">@color/patea_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/patea_background</item>
    </style>
</resources>
