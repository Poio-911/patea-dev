<?xml version="1.0" encoding="utf-8"?>
<!-- Lo primero que se ve al abrir la app, antes de que arranque Flutter.
     Tiene que coincidir con el fondo de la pantalla de arranque de Dart
     (_SplashScreen en app_router.dart) para que el pase sea invisible. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/patea_background" />
    <item>
        <bitmap
            android:gravity="center"
            android:src="@drawable/logo_patea" />
    </item>
</layer-list>
