<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Ventana mientras arranca el proceso. La app es oscura siempre, así que
         no hay variante clara: values/ y values-night/ son iguales a
         propósito. Antes values/ heredaba de Theme.Light y pintaba blanco. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
    <!-- Ventana detrás de la UI de Flutter una vez que arrancó. -->
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/patea_background</item>
    </style>
</resources>
