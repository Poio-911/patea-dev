{
  "name": "patea-functions",
  "version": "1.0.0",
  "description": "Firebase Cloud Functions for Pateá app",
  "main": "lib/index.js",
  "scripts": {
    "build": "tsc",
    "test": "npm run build && node --test test/*.test.cjs",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log"
  },
  "engines": {
    "node": "22"
  },
  "dependencies": {
    "@google/genai": "^3.3.0",
    "@google/generative-ai": "^0.24.1",
    "firebase-admin": "^13.6.0",
    "firebase-functions": "^7.0.1",
    "geofire-common": "^6.0.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@types/node": "^20.10.0",
    "firebase": "^13.3.0",
    "typescript": "^5.0.0"
  },
  "private": true
}
